@page
@model LoginModel

@{
    ViewData["Title"] = "Prijava";
}

<h1>Prijavi se.</h1>
<div class="login">
    <div class="row">
        <div class="col-md-4">
            <section>
                <form id="account" method="post">
               
                    <hr />
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Unesi Email" />
                       
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Unesi lozinku" />
                        
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    
                    <div>
                        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Prijavi se</button>
                    </div>
                    <div>
                    
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
