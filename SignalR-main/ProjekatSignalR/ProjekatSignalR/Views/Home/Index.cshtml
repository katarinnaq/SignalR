@{
    ViewData["Title"] = "Početna";
}

<div class="chat-app">

    <!-- sidebar -->
    <div class="sidebar">

        <div class="sidebar-top">
            <div class="sidebar-logo">
                <img src="/images/logoChatSphere.png" alt="ChatSphere Logo">
            </div>
        </div>

        <div class="sidebar-menu">

            <!-- cetovi -->
            <div class="sidebar-icon active" id="chatBtn">
                <i class="bi bi-chat-left-text-fill"></i>
            </div>

            <!-- grupe -->
            <div class="sidebar-icon" id="groupBtn">
                <i class="bi bi-people-fill"></i>
            </div>

            <!-- korisnici -->
            <div class="sidebar-icon" id="usersBtn">
                <i class="bi bi-person-lines-fill"></i>
            </div>

            <!-- podesavanja -->
            <div class="sidebar-icon">
                <i class="bi bi-gear-fill"></i>
            </div>

        </div>
    </div>

    <!-- levi panel -->
    <div class="chat-list">

        <!-- privatni chat -->
        <div id="chatPanel">
            <h2>Privatni chat</h2>

            <ul id="privateChatsList" class="chat-items"></ul>
        </div>

        <!-- grupni panel -->
        <div id="groupPanel" style="display:none;">

            <h2>Kreiranje nove grupe</h2>

            <div>
                <input type="text" id="newGroupName" placeholder="Ime grupe..." />

                <br><br>

                <div id="groupUsersContainer">
                    <p>Izaberite korisnike za grupu:</p>

                    <ul id="groupUsersList"></ul>

                    <br>

                    <button id="createGroupBtn">
                        Kreiraj grupu
                    </button>
                </div>
            </div>

            <br>

            <h2>Lista grupa</h2>
            <ul id="groupList"></ul>

            <h2>Izaberi grupu</h2>
            <ul id="groupChatsList" class="chat-items"></ul>
        </div>

        <!-- korisnicki panel -->
        <div id="usersPanel" style="display:none;">
            <h2>Svi korisnici</h2>

            <ul id="usersList"></ul>
        </div>
    </div>

    <!-- desni panel -->
    <div class="chat-window">

        <div class="chat-header">
            <div class="chat-user">
                <div class="online-dot"></div>

                <span id="activeChatUser">
                    Korisnik
                </span>
            </div>
        </div>

        <!-- privatne poruke -->
        <div class="messages-container">
            <ul id="messagesList"></ul>
        </div>

        <div class="message-input-container" id="privateMessageContainer">
            <input type="text"
                   id="messageInput"
                   placeholder="Pošalji poruku..." />

            <button id="sendBtn">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>

        <!-- grupne poruke -->
        <div class="group-messages-container" style="display:none;">
            <ul id="groupMessagesList"></ul>
        </div>

        <div class="message-input-container"
             id="groupMessageContainer"
             style="display:none;">

            <input type="text"
                   id="groupMessageInput"
                   placeholder="Poruka grupi..." />

            <button id="sendGroupBtn">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>

    </div>
</div>

@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>

    <script>

        // =========================
        // SIDEBAR
        // =========================

        const chatBtn = document.getElementById("chatBtn");
        const groupBtn = document.getElementById("groupBtn");
        const usersBtn = document.getElementById("usersBtn");

        const chatPanel = document.getElementById("chatPanel");
        const groupPanel = document.getElementById("groupPanel");
        const usersPanel = document.getElementById("usersPanel");

        function resetSidebar() {

            document.querySelectorAll(".sidebar-icon")
                .forEach(icon => icon.classList.remove("active"));
        }

        chatBtn.addEventListener("click", () => {

            resetSidebar();
            chatBtn.classList.add("active");

            chatPanel.style.display = "block";
            groupPanel.style.display = "none";
            usersPanel.style.display = "none";
        });

        groupBtn.addEventListener("click", () => {

            resetSidebar();
            groupBtn.classList.add("active");

            chatPanel.style.display = "none";
            groupPanel.style.display = "block";
            usersPanel.style.display = "none";
        });

        usersBtn.addEventListener("click", () => {

            resetSidebar();
            usersBtn.classList.add("active");

            chatPanel.style.display = "none";
            groupPanel.style.display = "none";
            usersPanel.style.display = "block";
        });

        // =========================
        // GLOBALNE PROMENLJIVE
        // =========================

        let currentUserId = '@ViewBag.UserId';
        let currentUserName = '@User.Identity.Name';

        let usersCache = [];

        let activePrivateUserId = null;
        let activeGroupId = null;

        console.log("Trenutni korisnik:", currentUserId);

        // =========================
        // SIGNALR
        // =========================

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chathub")
            .build();

        // =========================
        // UI FUNKCIJE
        // =========================

        function updateChatUI() {

            const privateMessages =
                document.querySelector(".messages-container");

            const privateInput =
                document.getElementById("privateMessageContainer");

            const groupMessages =
                document.querySelector(".group-messages-container");

            const groupInput =
                document.getElementById("groupMessageContainer");

            // grupni chat
            if (activeGroupId) {

                groupMessages.style.display = "block";
                groupInput.style.display = "flex";

                privateMessages.style.display = "none";
                privateInput.style.display = "none";
            }

            // privatni chat
            else if (activePrivateUserId) {

                privateMessages.style.display = "block";
                privateInput.style.display = "flex";

                groupMessages.style.display = "none";
                groupInput.style.display = "none";
            }

            // nista nije izabrano
            else {

                privateMessages.style.display = "none";
                privateInput.style.display = "none";

                groupMessages.style.display = "none";
                groupInput.style.display = "none";
            }
        }

        function addMessage(text) {
            const li = document.createElement("li");
            
            // moje poruke
            if(text.startsWith("Ja:")) {
                li.classList.add("my-message");
                li.textContent = text.replace("Ja:", "").trim();
            }
            // tudje poruke
            else {
                li.classList.add("other-message");
                li.textContent = text;
            }

            document.getElementById("messagesList").appendChild(li);
        }

        function addGroupMessage(text) {

            const li = document.createElement("li");

            li.textContent = text;

            document
                .getElementById("groupMessagesList")
                .appendChild(li);
        }

        function getUserName(userId) {

            const user =
                usersCache.find(u => u.id === userId);

            return user ? user.userName : userId;
        }

        // =========================
        // SIGNALR EVENTS
        // =========================

        connection.on("ReceivePrivateMessage",
            (senderId, message) => {

                const senderName =
                    senderId === currentUserId
                        ? "Ja"
                        : getUserName(senderId);

                addMessage(`${senderName}: ${message}`);
            });

        connection.on("ReceiveGroupMessage",
            (senderId, message) => {

                const senderName =
                    senderId === currentUserId
                        ? "Ja"
                        : getUserName(senderId);

                addGroupMessage(`${senderName}: ${message}`);
            });

        // =========================
        // START SIGNALR
        // =========================

        connection.start()
            .then(() => {

                console.log("SignalR konekcija uspešna");

                loadUsers();
                loadGroups();
            })
            .catch(err => console.error(err.toString()));

        // =========================
        // UCITAVANJE KORISNIKA
        // =========================

        function loadUsers() {

            fetch("/api/User")
                .then(response => response.json())
                .then(users => {

                    usersCache = users;

                    const usersList =
                        document.getElementById("usersList");

                    const groupUsersList =
                        document.getElementById("groupUsersList");

                    usersList.innerHTML = "";
                    groupUsersList.innerHTML = "";

                    users.forEach(u => {

                        // PRIVATNI CHAT
                        const li = document.createElement("li");

                        li.innerHTML = `
                            <div class="chat-avatar">
                                ${u.userName.charAt(0).toUpperCase()}
                            </div>

                            <div>
                                <strong>${u.userName}</strong>
                            </div>
                        `;

                        li.addEventListener("click", () => {

                            activePrivateUserId = u.id;
                            activeGroupId = null;

                            updateChatUI();

                            document.querySelectorAll("#privateChatsList li")
                                .forEach(x =>
                                    x.classList.remove("active-chat"));

                            li.classList.add("active-chat");

                            document.getElementById("activeChatUser")
                                .textContent = u.userName;

                            loadPrivateMessages(u.id);
                        });

                        document
                            .getElementById("privateChatsList")
                            .appendChild(li);

                        // LISTA KORISNIKA
                        const userLi = document.createElement("li");

                        userLi.textContent = u.userName;

                        usersList.appendChild(userLi);

                        // CHECKBOX ZA GRUPU
                        const liGroup = document.createElement("li");

                        const checkbox =
                            document.createElement("input");

                        checkbox.type = "checkbox";
                        checkbox.value = u.id;
                        checkbox.id = `user_${u.id}`;

                        const label =
                            document.createElement("label");

                        label.htmlFor = `user_${u.id}`;
                        label.textContent = u.userName;

                        liGroup.appendChild(checkbox);
                        liGroup.appendChild(label);

                        groupUsersList.appendChild(liGroup);
                    });
                });
        }

        // =========================
        // UCITAVANJE GRUPA
        // =========================

        function loadGroups() {

            fetch("/api/Group")
                .then(res => res.json())
                .then(groups => {

                    groups.forEach(g => {

                        const li =
                            document.createElement("li");

                        li.innerHTML = `
                            <div class="chat-avatar">
                                <i class="bi bi-people-fill"></i>
                            </div>

                            <div>
                                <strong>${g.naziv}</strong>
                            </div>
                        `;

                        li.addEventListener("click", () => {

                            activeGroupId = g.id;
                            activePrivateUserId = null;

                            updateChatUI();

                            document.querySelectorAll("#groupChatsList li")
                                .forEach(x =>
                                    x.classList.remove("active-chat"));

                            li.classList.add("active-chat");

                            document.getElementById("activeChatUser")
                                .textContent = g.naziv;

                            loadGroupMessages(g.id);
                        });

                        document
                            .getElementById("groupChatsList")
                            .appendChild(li);

                        // lista grupa
                        const groupLi =
                            document.createElement("li");

                        groupLi.textContent = g.naziv;

                        document
                            .getElementById("groupList")
                            .appendChild(groupLi);
                    });
                });
        }

        // =========================
        // PRIVATNE PORUKE
        // =========================

        document.getElementById("sendBtn")
            .addEventListener("click", () => {

                const receiverId = activePrivateUserId;

                const message =
                    document.getElementById("messageInput").value;

                if (!receiverId) {

                    alert("Izaberite korisnika!");
                    return;
                }

                if (!message.trim()) {
                    return;
                }

                connection.invoke(
                    "SendPrivateMessage",
                    currentUserId,
                    receiverId,
                    message
                )
                .catch(err => console.error(err.toString()));

                document.getElementById("messageInput").value = "";
            });

        function loadPrivateMessages(otherUserId) {

            fetch(`/api/User/messages/${otherUserId}`,
                {
                    credentials: "include"
                })
                .then(res => res.json())
                .then(messages => {

                    if (!Array.isArray(messages)) {

                        console.error("Poruke nisu niz!", messages);

                        messages = [];
                    }

                    const list =
                        document.getElementById("messagesList");

                    list.innerHTML = "";
                    // izmenjeno
                    messages.forEach(m => {

                        const sender =
                            m.posiljalacId === currentUserId
                            ? 'Ja'
                            : getUserName(m.posiljalacId);

                        addMessage(`${sender}: ${m.sadrzaj}`);
                    });
                })
                .catch(err => {

                    console.error(err);

                    alert("Greška prilikom učitavanja poruka.");
                });
        }

        // =========================
        // KREIRANJE GRUPE
        // =========================

        document.getElementById("createGroupBtn")
            .addEventListener("click", () => {

                const groupName =
                    document.getElementById("newGroupName").value;

                if (!groupName.trim()) {

                    alert("Unesite ime grupe!");
                    return;
                }

                const selectedUserIds =
                    Array.from(
                        document.querySelectorAll(
                            "#groupUsersList input[type=checkbox]"
                        )
                    )
                    .filter(cb => cb.checked)
                    .map(cb => cb.value);

                if (!selectedUserIds.length) {

                    alert("Izaberite bar jednog korisnika!");
                    return;
                }

                fetch("/api/CreateGroup/create", {

                    method: "POST",

                    headers: {
                        "Content-Type": "application/json"
                    },

                    body: JSON.stringify({
                        naziv: groupName,
                        korisniciId:
                            selectedUserIds.concat(currentUserId)
                    })
                })
                .then(res => res.json())
                .then(newGroup => {

                    alert(`Grupa "${newGroup.naziv}" kreirana!`);

                    document.getElementById("newGroupName").value = "";

                    document.querySelectorAll(
                        "#groupUsersList input[type=checkbox]"
                    )
                    .forEach(cb => cb.checked = false);

                    // reload grupa
                    document.getElementById("groupChatsList").innerHTML = "";
                    document.getElementById("groupList").innerHTML = "";

                    loadGroups();
                })
                .catch(err => console.error(err));
            });

        
        // GRUPNE PORUKE

        document.getElementById("sendGroupBtn")
            .addEventListener("click", () => {

                const groupId = activeGroupId;

                const message =
                    document.getElementById("groupMessageInput").value;

                if (!groupId) {

                    alert("Izaberite grupu!");
                    return;
                }

                if (!message.trim()) {
                    return;
                }

                connection.invoke(
                    "SendGroupMessage",
                    parseInt(groupId),
                    currentUserId,
                    message
                )
                .catch(err => console.error(err.toString()));

                document.getElementById("groupMessageInput").value = "";
            });

        function loadGroupMessages(groupId) {

            fetch(`/api/Group/messages/${groupId}`)
                .then(res => res.json())
                .then(messages => {

                    const list =
                        document.getElementById("groupMessagesList");

                    list.innerHTML = "";

                    messages.forEach(m => {

                        const sender = m.posiljalacId === currentUserId ? "Ja" : getUserName(m.posiljalacId);
                        addMessage(`${sender}:${m.sadrzaj}`)
                    });
                });
        }

        // inicijalno sakrij chat
        updateChatUI();

    </script>
}